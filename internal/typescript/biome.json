{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/target",
      "!**/vendor",
      "!**/.git",
      "!**/.bare",
      "!**/.next",
      "!**/coverage"
    ]
  },
  "vcs": { "enabled": false },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "security": "error",
      "correctness": "error"
    }
  }
}
